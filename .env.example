# ---------------------------------------------------------------------------
# DEMO MODE = FOCUS UAT PREVIEW
# ---------------------------------------------------------------------------
# Leave unset (or anything but "false") and the portal shows Dingli's Focus UAT
# data, synced into Supabase by api/focus-sync.ts: login is a dealer dropdown
# plus one shared password, and data is read through api/uat-data.ts. Nothing
# is generated. Set to false once production Focus is connected — dealers then
# sign in with their own Supabase accounts (see src/config/demo.ts).
VITE_DEMO_MODE=true

# The one shared password for the UAT preview login. Server-side only; anyone
# who has it can view every dealer's UAT data.
UAT_ACCESS_PASSWORD=choose-a-shared-password

# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your Supabase project's credentials.
# Find these under Project Settings -> API in the Supabase dashboard.
# These are safe to expose client-side (the anon key relies on Row Level Security).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by api/chat.ts (a Vercel serverless function) — NEVER prefix this
# with VITE_, which would bundle it into the client and expose it in the browser.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# api/chat.ts also needs the two VITE_-prefixed vars above at runtime (Vercel
# exposes all env vars to serverless functions regardless of prefix — the
# VITE_ prefix only controls what gets inlined into the client bundle).

# ---------------------------------------------------------------------------
# FOCUS ERP DATABASE
# ---------------------------------------------------------------------------
# Connection details for the Focus database. Put the real values in .env.local
# (gitignored) — never in this file, which is committed to a public repo.

FOCUS_DB_USERNAME=your-focus-db-username
FOCUS_DB_PASSWORD=your-focus-db-password
FOCUS_UAT_DB_IP=your-focus-db-host
FOCUS_CRM_DB=your-focus-crm-db-name
FOCUS_MAIN_DB=your-focus-main-db-name

# ---------------------------------------------------------------------------
# FOCUS -> SUPABASE SYNC (api/focus-sync.ts, daily Vercel cron)
# ---------------------------------------------------------------------------
# Server-side only — never prefix with VITE_. The service-role key bypasses RLS
# so the sync can write every dealer's rows; keep it in Vercel, nowhere else.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Vercel Cron sends this as a Bearer token; manual runs pass it as ?token=.
CRON_SECRET=a-long-random-string
